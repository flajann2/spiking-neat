executable playground-zmq-bi-ser
    import:           commons
                    , bincoms
    ghc-options: -rtsopts
                 -with-rtsopts=-N
    main-is:     PairServer.hs
    build-depends:
        mtl
      , spiking-neat
    hs-source-dirs:
        playground/zmq

executable playground-zmq-bi-cli
    import:           commons
                    , bincoms
    ghc-options: -rtsopts
                 -with-rtsopts=-N
    main-is:     PairClient.hs
    build-depends:
        mtl
      , liquidhaskell-boot
      , spiking-neat
    hs-source-dirs:
