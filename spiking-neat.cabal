executable playground-unagi
    import:           commons
                    , bincoms
    ghc-options: -rtsopts
                 -with-rtsopts=-N
    main-is:     Unagi.hs
    build-depends:
        mtl
      , spiking-neat
    hs-source-dirs:
        playground

test-suite ss-spec
    import:           commons
                    , bincoms
    type: exitcode-stdio-1.0
    main-is: Spec.hs
    hs-source-dirs: test
    build-depends:
        base >=4.7 && <5
      , hspec
      , QuickCheck
      , spiking-neat
